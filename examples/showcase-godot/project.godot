; Engine configuration file.
; Godot 4.7 showcase whose textures, map, SFX, font and SpriteFrames
; are produced by the gamestudio-tools kit. Do not hand-edit generated
; files under art/, sfx/, font/ or preview/; run ./build_showcase.sh.
config_version=5

[application]

config/name="GST Showcase"
config/description="Minimal top-down scene built entirely from gamestudio-tools generators"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=320
window/size/viewport_height=240
window/size/window_width_override=640
window/size/window_height_override=480
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.2, 0.15, 0.1, 1)

[physics]

2d/default_gravity=0.0

[layer_names]

2d_physics/layer_1="world"
