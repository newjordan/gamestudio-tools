[internationalization]

locale/translations=PackedStringArray("res://i18n/loc.en.translation", "res://i18n/loc.de.translation", "res://i18n/loc.fr.translation")
locale/fallback="en"

[navigation]

; synchronous map/region updates so the autoplay nav probe is stable
world/map_use_async_iterations=false
world/region_use_async_iterations=false

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
environment/defaults/default_clear_color=Color(0.055, 0.086, 0.07, 1)
