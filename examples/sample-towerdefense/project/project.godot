; Engine configuration file.
; Reed Causeway - gamestudio-tools sample-towerdefense. Hand-written; every
; asset it references is produced by build.sh with gst.

config_version=5

[application]

config/name="Reed Causeway"
config/description="Tower defense sample built with gamestudio-tools"
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://art/icon.png"

[audio]

buses/default_bus_layout=""

[autoload]

Game="*res://scripts/game.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=192
window/size/window_width_override=640
window/size/window_height_override=384
window/stretch/mode="viewport"

