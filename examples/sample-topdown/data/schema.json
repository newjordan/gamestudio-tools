{"tables": {
  "items": {"file": "items.csv", "key": "id", "fields": {
    "id": {"type": "str", "pattern": "^[a-z_]+$", "unique": true},
    "kind": {"type": "enum", "values": ["currency", "heal", "key"]},
    "value": {"type": "int", "min": 1},
    "sfx": {"type": "str"}}},
  "enemies": {"file": "enemies.csv", "key": "id", "fields": {
    "id": {"type": "str", "pattern": "^[a-z_]+$", "unique": true},
    "name_key": {"type": "str", "pattern": "^enemy_[a-z_]+$"},
    "behaviour": {"type": "enum", "values": ["chase", "shoot", "boss"]},
    "hp": {"type": "int", "min": 1, "max": 30},
    "speed": {"type": "float", "min": 10, "max": 200},
    "damage": {"type": "int", "min": 1, "max": 3},
    "aggro": {"type": "float", "min": 0},
    "fire_cd": {"type": "float", "min": 0},
    "shot_speed": {"type": "float", "min": 0},
    "drop": {"type": "enum", "values": ["common", "elite", "boss"]},
    "anim": {"type": "str"}}}
}}
