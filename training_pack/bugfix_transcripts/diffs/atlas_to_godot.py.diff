+def trim_margin(rec, w, h):
+    """Godot AtlasTexture margin (left, top, extra width, extra height) that restores a trimmed frame's
+    original canvas from spriteSourceSize / sourceSize, or None when the frame is not trimmed."""
+    ss, src = rec.get("spriteSourceSize"), rec.get("sourceSize")
+    if not isinstance(ss, dict) or not isinstance(src, dict):
+        return None
+    try:
+        ox, oy = int(ss.get("x", 0)), int(ss.get("y", 0))
+        sw, sh = int(src["w"]), int(src["h"])
+    except (KeyError, TypeError, ValueError):
+        return None
+    ew, eh = sw - w, sh - h
+    if ox == 0 and oy == 0 and ew == 0 and eh == 0:
+        return None
+    if ox < 0 or oy < 0 or ew < ox or eh < oy:
+        return None  # inconsistent trim data: keep the bare region rather than guess
+    return ox, oy, ew, eh
+
