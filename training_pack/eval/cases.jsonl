{"id": "sprite_scale_x2", "tool": "sprite-scale", "prompt": "Scale my 16x16 sprite up 2x with nearest neighbour into out/.", "cmd": "gst sprite-scale sprite.png -o out --scale 2", "checks": [["exit", 0], ["png", "out/sprite.png", 32, 32], ["unchanged", "sprite.png"]]}
{"id": "sprite_scale_size", "tool": "sprite-scale", "prompt": "Resize sprite.png to exactly 48x48 pixels.", "cmd": "gst sprite-scale sprite.png -o out --size 48x48", "checks": [["exit", 0], ["png", "out/sprite.png", 48, 48]]}
{"id": "sprite_canvas_center", "tool": "sprite-canvas", "prompt": "Put sprite.png centred on a 32x24 transparent canvas.", "cmd": "gst sprite-canvas sprite.png -o out --size 32x24 --anchor center", "checks": [["exit", 0], ["png", "out/sprite.png", 32, 24], ["img_pixel", "out/sprite.png", 0, 0, [0, 0, 0, 0]], ["img_pixel", "out/sprite.png", 16, 12, [255, 0, 77, 255]]]}
{"id": "sprite_pad_uniform", "tool": "sprite-pad", "prompt": "Add 2 px of transparent padding on every side of sprite.png.", "cmd": "gst sprite-pad sprite.png -o out --pad 2", "checks": [["exit", 0], ["png", "out/sprite.png|out", 20, 20]]}
{"id": "sprite_pad_ltrb", "tool": "sprite-pad", "prompt": "Pad sprite.png by left 1, top 2, right 3, bottom 4.", "cmd": "gst sprite-pad sprite.png -o out --pad 1,2,3,4", "checks": [["exit", 0], ["png", "out/sprite.png|out", 20, 22]]}
{"id": "sprite_trim", "tool": "sprite-trim", "prompt": "Trim the empty border off frames/walk_0.png.", "cmd": "gst sprite-trim frames/walk_0.png -o out", "checks": [["exit", 0], ["png", "out/walk_0.png", 8, 8]]}
{"id": "sprite_trim_padding", "tool": "sprite-trim", "prompt": "Trim walk_0 but keep 1 px of padding.", "cmd": "gst sprite-trim frames/walk_0.png -o out --padding 1", "checks": [["exit", 0], ["png", "out/walk_0.png", 10, 10]]}
{"id": "outline_outer_keep", "tool": "sprite-outline-gen", "prompt": "Give sprite.png a 1 px outer outline in #1d2b53 without changing its size.", "cmd": "gst sprite-outline-gen sprite.png -o out --mode outer --width 1 --color '#1d2b53' --keep-size", "checks": [["exit", 0], ["png", "out/*.png", 16, 16], ["img_opaque_more", "out/*.png", "sprite.png"], ["img_pixel", "out/*.png", 3, 8, [29, 43, 83, 255]]]}
{"id": "shadow_drop_keep", "tool": "sprite-shadow", "prompt": "Add a drop shadow under sprite.png, keep the canvas size.", "cmd": "gst sprite-shadow sprite.png -o out --mode drop --keep-size", "checks": [["exit", 0], ["png", "out/*.png", 16, 16], ["img_differs", "out/*.png", "sprite.png"]]}
{"id": "palette_apply_builtin", "tool": "palette-apply", "prompt": "Force sprite.png and grad.png onto the PICO-8 palette.", "cmd": "gst palette-apply sprite.png grad.png -o out --palette pico8", "checks": [["exit", 0], ["glob", "out/*.png", 2], ["img_colors_in", "out/grad*.png", "pico8.hex"], ["img_colors_in", "out/sprite*.png", "pico8.hex"]]}
{"id": "palette_apply_hexfile", "tool": "palette-apply", "prompt": "Quantise grad.png to the colours listed in pico8.hex.", "cmd": "gst palette-apply grad.png -o out --palette pico8.hex", "checks": [["exit", 0], ["img_colors_in", "out/*.png", "pico8.hex"], ["png", "out/*.png", 32, 32]]}
{"id": "palette_swap_hue", "tool": "palette-swap", "prompt": "Make a hue-shifted (180 degrees) variant of sprite.png.", "cmd": "gst palette-swap sprite.png -o out --hue 180", "checks": [["exit", 0], ["png", "out/*.png", 16, 16], ["img_differs", "out/*.png", "sprite.png"], ["img_alpha_equal", "out/*.png", "sprite.png"]]}
{"id": "palette_extract", "tool": "palette-extract", "prompt": "Extract a 4-colour palette swatch from grad.png.", "cmd": "gst palette-extract grad.png -o pal -n 4", "checks": [["exit", 0], ["png", "pal_swatch.png"], ["exists", "pal.gpl"], ["count", "pal.hex", "\n", 4]]}
{"id": "team_outline", "tool": "team-outline", "prompt": "Make a blue team variant of sprite.png, where #ff004d is the team-colour key.", "cmd": "gst team-outline sprite.png -o out --team blue=#29adff --key '#ff004d'", "checks": [["exit", 0], ["glob_min", "out/*.png", 1]]}
{"id": "alpha_bleed", "tool": "alpha-bleed", "prompt": "Bleed sprite colours into the transparent pixels so filtering does not make dark fringes.", "cmd": "gst alpha-bleed sprite.png -o out", "checks": [["exit", 0], ["img_alpha_equal", "out/sprite.png|out", "sprite.png"], ["img_differs", "out/sprite.png|out", "sprite.png"]]}
{"id": "pixel_lint_clean", "tool": "pixel-lint", "prompt": "Lint pixel.png as pixel art (max 4 colours), fail on problems.", "cmd": "gst pixel-lint pixel.png --max-colors 4 --strict", "checks": [["exit", 0]]}
{"id": "pixel_lint_upscaled_warns", "tool": "pixel-lint", "prompt": "sprite.png is a 4x-blocky image; strict lint should flag it.", "cmd": "gst pixel-lint sprite.png --strict", "checks": [["exit_nonzero"], ["stdout_contains", "upscaled"]]}
{"id": "pixel_lint_too_many_colours", "tool": "pixel-lint", "prompt": "Lint grad.png with a 4-colour limit; it should fail.", "cmd": "gst pixel-lint grad.png --max-colors 4 --strict", "checks": [["exit_nonzero"]]}
{"id": "image_diff_same", "tool": "image-diff", "prompt": "Diff sprite.png against itself.", "cmd": "gst image-diff sprite.png sprite.png --max-changed 0", "checks": [["exit", 0]]}
{"id": "image_diff_changed", "tool": "image-diff", "prompt": "Diff walk_0 against walk_1 and fail on any change.", "cmd": "gst image-diff frames/walk_0.png frames/walk_1.png --max-changed 0", "checks": [["exit_nonzero"]]}
{"id": "texture_resize_max", "tool": "texture-resize", "prompt": "Shrink odd.png (20x12) so its longest edge is 10 px.", "cmd": "gst texture-resize odd.png -o out --max 10", "checks": [["exit", 0], ["png", "out/odd.png", 10, 6]]}
{"id": "texture_resize_pot", "tool": "texture-resize", "prompt": "Make odd.png power-of-two sized.", "cmd": "gst texture-resize odd.png -o out --pot", "checks": [["exit", 0], ["img_pot", "out/odd.png"]]}
{"id": "lut_identity_roundtrip", "tool": "lut-tool", "prompt": "Make an identity LUT and apply it to grad.png; the image should not change.", "cmd": "gst lut-tool identity --size 16 -o id.png && gst lut-tool apply grad.png --lut id.png -o same.png", "checks": [["exit", 0], ["img_close", "same.png", "grad.png", 2]]}
{"id": "lut_make_darker", "tool": "lut-tool", "prompt": "Make a LUT that darkens by 0.2 and apply it to grad.png.", "cmd": "gst lut-tool make --size 16 --brightness -0.2 -o dark.png && gst lut-tool apply grad.png --lut dark.png -o out.png", "checks": [["exit", 0], ["png", "out.png", 32, 32], ["img_mean_lt", "out.png", "grad.png"]]}
{"id": "colorblind_sim", "tool": "colorblind-sim", "prompt": "Preview grad.png as seen with deuteranopia.", "cmd": "gst colorblind-sim sim grad.png -o cb --type deutan", "checks": [["exit", 0], ["glob_min", "cb/*.png", 1]]}
{"id": "channel_pack_orm", "tool": "channel-pack", "prompt": "Pack ao.png, rough.png and metal.png into one ORM texture.", "cmd": "gst channel-pack pack -o orm.png --preset orm --ao ao.png --roughness rough.png --metallic metal.png", "checks": [["exit", 0], ["png", "orm.png", 16, 16], ["img_pixel", "orm.png", 5, 5, [200, 100, 0], 1]]}
{"id": "normal_bake", "tool": "normal-bake", "prompt": "Bake a normal map from height.png.", "cmd": "gst normal-bake height.png -o nb", "checks": [["exit", 0], ["png", "nb/*normal*.png", 32, 32]]}
{"id": "tex_gen_bricks", "tool": "tex-gen", "prompt": "Generate a 32 px tileable brick texture with seed 1.", "cmd": "gst tex-gen bricks -o b.png --size 32 --seed 1", "checks": [["exit", 0], ["png", "b.png", 32, 32]]}
{"id": "tex_gen_deterministic", "tool": "tex-gen", "prompt": "Generating noise twice with the same seed must give identical files.", "cmd": "gst tex-gen noise -o a.png --size 16 --seed 4 && gst tex-gen noise -o b.png --size 16 --seed 4", "checks": [["exit", 0], ["files_identical", "a.png", "b.png"], ["png", "a.png", 16, 16]]}
{"id": "tileset_gen_blob", "tool": "tileset-gen", "prompt": "Build a 47-tile blob autotile sheet from two 16 px terrain fills.", "cmd": "gst tileset-gen -o blob --tile 16 --inner in.png --outer outr.png", "checks": [["exit", 0], ["png", "blob.png"], ["img_size_multiple", "blob.png", 16], ["json", "blob.json"]], "pre": ["gst tex-gen bricks -o in.png --size 16 --seed 1", "gst tex-gen noise -o outr.png --size 16 --seed 2"]}
{"id": "tile_dedupe", "tool": "tile-dedupe", "prompt": "Remove duplicate tiles from tiles_dup.png (16 px tiles, 2 columns).", "cmd": "gst tile-dedupe tiles_dup.png --tile 16 -o dd --columns 2", "checks": [["exit", 0], ["png", "dd.png", 32, 16], ["json", "dd.json"]]}
{"id": "nine_slice_bake", "tool": "nine-slice", "prompt": "Bake sprite.png as a 9-slice at 64x32 with 4 px insets.", "cmd": "gst nine-slice sprite.png --insets 4,4,4,4 --size 64x32 -o ns.png", "checks": [["exit", 0], ["png", "ns.png", 64, 32]]}
{"id": "nine_slice_to_godot", "tool": "nine-slice-to-godot", "prompt": "Make a Godot StyleBoxTexture from sprite.png with 4 px insets.", "cmd": "gst nine-slice-to-godot sprite.png -o ns.tres --insets 4,4,4,4", "checks": [["exit", 0], ["starts", "ns.tres", "[gd_resource"], ["contains", "ns.tres", "StyleBoxTexture"], ["regex", "ns.tres", "texture_margin_left = 4(\\.0)?\\b"]]}
{"id": "icon_gen", "tool": "icon-gen", "prompt": "Generate an app icon set from a 1024 px master.", "cmd": "gst icon-gen big/sprite.png -o icons --bg '#1d2b53'", "checks": [["exit", 0], ["png", "icons/web/icon-192.png", 192, 192]], "pre": ["gst sprite-scale sprite.png -o big --size 1024x1024"]}
{"id": "contact_sheet", "tool": "contact-sheet", "prompt": "Make a contact sheet of all frames, 3 columns, 24x24 cells.", "cmd": "gst contact-sheet frames/*.png -o cs.png --cell 24x24 --columns 3", "checks": [["exit", 0], ["png", "cs.png"]]}
{"id": "onion_skin", "tool": "onion-skin", "prompt": "Make an onion-skin review of the walk frames.", "cmd": "gst onion-skin walk -o onion.png --loop", "checks": [["exit", 0], ["png", "onion.png"]], "pre": ["mkdir walk && cp frames/walk_*.png walk/"]}
{"id": "frames_to_sheet", "tool": "frames-to-sheet", "prompt": "Turn the frames folder into a 4-column sheet without cropping.", "cmd": "gst frames-to-sheet frames -o sh --columns 4 --no-crop", "checks": [["exit", 0], ["png", "sh.png", 64, 32], ["json", "sh.json"]]}
{"id": "sprite_slice_grid", "tool": "sprite-slice", "prompt": "Slice sheet.png into 16x16 frames.", "cmd": "gst sprite-slice sheet.png --grid 16x16 -o sl", "checks": [["exit", 0], ["glob", "sl/*.png", 4], ["all_png_size", "sl/*.png", 16, 16]]}
{"id": "gif_to_frames", "tool": "gif-to-frames", "prompt": "Split anim.gif into PNG frames.", "cmd": "gst gif-to-frames anim.gif -o gf", "checks": [["exit", 0], ["glob", "gf/*.png", 3]]}
{"id": "gif_optimize", "tool": "gif-optimize", "prompt": "Shrink anim.gif to 8 colours.", "cmd": "gst gif-optimize anim.gif -o small.gif --colors 8", "checks": [["exit", 0], ["img_frames", "small.gif", 3]]}
{"id": "atlas_pack", "tool": "atlas-pack", "prompt": "Pack every frame in frames/ into one atlas.", "cmd": "gst atlas-pack frames -o atlas", "checks": [["exit", 0], ["png", "atlas.png"], ["img_pot", "atlas.png"], ["json_len", "atlas.json", "frames", 6]]}
{"id": "atlas_pack_notrim", "tool": "atlas-pack", "prompt": "Pack frames/ without trimming and without power-of-two padding.", "cmd": "gst atlas-pack frames -o atlas --no-trim --no-pot", "checks": [["exit", 0], ["json_len", "atlas.json", "frames", 6], ["json_eq", "atlas.json", "frames.walk_0.frame.w", 16]]}
{"id": "atlas_validate", "tool": "atlas-validate", "prompt": "Validate the packed atlas against its PNG.", "cmd": "gst atlas-validate atlas.json", "checks": [["exit", 0]], "pre": ["gst atlas-pack frames -o atlas"]}
{"id": "atlas_unpack_untrim", "tool": "atlas-unpack", "prompt": "Unpack the atlas back to full-size (untrimmed) frames.", "cmd": "gst atlas-unpack atlas.json -o un --untrim", "checks": [["exit", 0], ["glob", "un/*.png", 6], ["all_png_size", "un/*.png", 16, 16]], "pre": ["gst atlas-pack frames -o atlas"]}
{"id": "atlas_roundtrip_pixels", "tool": "atlas-unpack", "prompt": "Pack then unpack untrimmed: walk_2 must come back pixel-identical.", "cmd": "gst atlas-unpack atlas.json -o un --untrim", "checks": [["exit", 0], ["img_equal", "un/walk_2*.png", "frames/walk_2.png"]], "pre": ["gst atlas-pack frames -o atlas"]}
{"id": "atlas_merge", "tool": "atlas-merge", "prompt": "Merge two atlases into one.", "cmd": "gst atlas-merge a1.json a2.json -o merged", "checks": [["exit", 0], ["png", "merged.png"], ["json_len", "merged.json", "frames", 6]], "pre": ["mkdir w i && cp frames/walk_* w/ && cp frames/idle_* i/", "gst atlas-pack w -o a1", "gst atlas-pack i -o a2"]}
{"id": "atlas_to_godot", "tool": "atlas-to-godot", "prompt": "Write a Godot SpriteFrames .tres from the atlas.", "cmd": "gst atlas-to-godot atlas.json -o frames.tres --res res://atlas.png", "checks": [["exit", 0], ["starts", "frames.tres", "[gd_resource type=\"SpriteFrames\""], ["count", "frames.tres", "[sub_resource type=\"AtlasTexture\"", 6]], "pre": ["gst atlas-pack frames -o atlas"]}
{"id": "atlas_to_godot_clips", "tool": "atlas-to-godot", "prompt": "SpriteFrames with named walk and idle animations from a clips JSON.", "cmd": "gst atlas-to-godot atlas.json -o frames.tres --clips clips.json --res res://atlas.png", "checks": [["exit", 0], ["contains", "frames.tres", "&\"walk\""], ["contains", "frames.tres", "&\"idle\""]], "pre": ["gst atlas-pack frames -o atlas", "gst anim-from-folder frames -o clips.json --pattern '{clip}_{frame}.png'"]}
{"id": "atlas_to_godot_trim_margin", "tool": "atlas-to-godot", "prompt": "Trimmed frames must keep their 16x16 canvas in Godot (margin).", "cmd": "gst atlas-to-godot atlas.json -o frames.tres --res res://atlas.png", "checks": [["exit", 0], ["regex", "frames.tres", "margin = Rect2\\("]], "pre": ["gst atlas-pack frames -o atlas"]}
{"id": "anim_from_folder", "tool": "anim-from-folder", "prompt": "Build clips from frames/: walk at 10 fps, idle plays once.", "cmd": "gst anim-from-folder frames -o clips.json --pattern '{clip}_{frame}.png' --fps walk=10 --once idle", "checks": [["exit", 0], ["json_eq", "clips.json", "clips.walk.fps", 10], ["json_len", "clips.json", "clips.walk.frames", 4], ["json_eq", "clips.json", "clips.idle.loop", false], ["json_eq", "clips.json", "clips.walk.loop", true]]}
{"id": "anim_from_folder_glob", "tool": "anim-from-folder", "prompt": "Set every clip starting with 'wa' to 6 fps using a glob.", "cmd": "gst anim-from-folder frames -o clips.json --pattern '{clip}_{frame}.png' --fps 'wa*=6' --default-fps 8", "checks": [["exit", 0], ["json_eq", "clips.json", "clips.walk.fps", 6], ["json_eq", "clips.json", "clips.idle.fps", 8]]}
{"id": "frame_timing_check", "tool": "frame-timing-check", "prompt": "Check the 12 fps clips against a 12 fps grid, strictly.", "cmd": "gst frame-timing-check clips.json --fps 12 --strict --report ft.json", "checks": [["exit", 0], ["json", "ft.json"]], "pre": ["gst anim-from-folder frames -o clips.json --pattern '{clip}_{frame}.png' --default-fps 12"]}
{"id": "spritesheet_gif", "tool": "spritesheet-gif", "prompt": "Render the walk clip of the atlas to a GIF.", "cmd": "gst spritesheet-gif atlas.json --clips clips.json --clip walk -o walk.gif", "checks": [["exit", 0], ["img_frames", "walk.gif", 4]], "pre": ["gst atlas-pack frames -o atlas", "gst anim-from-folder frames -o clips.json --pattern '{clip}_{frame}.png'"]}
{"id": "sprite_angles", "tool": "sprite-angles", "prompt": "Bake sprite.png at 8 rotation angles into a sheet.", "cmd": "gst sprite-angles sprite.png -o ang.png --angles 8 --prefix s", "checks": [["exit", 0], ["png", "ang.png"], ["json_len", "ang.json", "frames", 8]]}
{"id": "sprite_flip_sheet", "tool": "sprite-flip-sheet", "prompt": "Make a horizontally flipped copy of the atlas sheet.", "cmd": "gst sprite-flip-sheet atlas.png atlas.json -o flip.png --horizontal", "checks": [["exit", 0], ["png", "flip.png"]], "pre": ["gst atlas-pack frames -o atlas --no-trim"]}
{"id": "hitbox_gen", "tool": "hitbox-gen", "prompt": "Generate a hitbox from walk_0's alpha.", "cmd": "gst hitbox-gen frames/walk_0.png -o hb.json", "checks": [["exit", 0], ["json", "hb.json"]]}
{"id": "hitbox_to_godot", "tool": "hitbox-to-godot", "prompt": "Turn the hitboxes into a Godot Area2D scene with AABB shapes.", "cmd": "gst hitbox-to-godot hb.json -o hb.tscn --shape aabb", "checks": [["exit", 0], ["starts", "hb.tscn", "[gd_scene"], ["contains", "hb.tscn", "Area2D"]], "pre": ["gst hitbox-gen frames/walk_0.png -o hb.json"]}
{"id": "dungeon_gen_bsp", "tool": "dungeon-gen", "prompt": "Generate a 30x20 BSP dungeon with seed 3.", "cmd": "gst dungeon-gen --mode bsp --size 30x20 --seed 3 -o d", "checks": [["exit", 0], ["ascii_grid", "d.txt", 30, 20], ["tiled_dims", "d.json", 30, 20], ["png", "d.png", 240, 160], ["json_len_min", "d.json", "tilesets", 1]]}
{"id": "dungeon_gen_deterministic", "tool": "dungeon-gen", "prompt": "Same seed twice must give the same map.", "cmd": "gst dungeon-gen --size 24x16 --seed 9 -o a && gst dungeon-gen --size 24x16 --seed 9 -o b", "checks": [["exit", 0], ["files_identical", "a.txt", "b.txt"]]}
{"id": "dungeon_gen_caves", "tool": "dungeon-gen", "prompt": "Generate a 40x25 cave map.", "cmd": "gst dungeon-gen --mode caves --size 40x25 --seed 2 -o c", "checks": [["exit", 0], ["ascii_grid", "c.txt", 40, 25], ["tiled_dims", "c.json", 40, 25]]}
{"id": "map_blank", "tool": "map-blank", "prompt": "Make an empty 12x9 map with layers a and b.", "cmd": "gst map-blank -o b.json --size 12x9 --tile 16 --layers a,b", "checks": [["exit", 0], ["tiled_dims", "b.json", 12, 9], ["json_len", "b.json", "layers", 2]]}
{"id": "map_fill_rect", "tool": "map-fill", "prompt": "Fill a 3x2 rectangle at 0,0 of the ground layer with gid 2.", "cmd": "gst map-fill map.json -o f.json --layer ground --gid 2 --rect 0,0,3,2", "checks": [["exit", 0], ["tiled_layer_count", "f.json", "ground", 2, 6], ["tiled_layer_count", "f.json", "ground", 1, 74], ["unchanged", "map.json"]]}
{"id": "map_mirror_h", "tool": "map-mirror", "prompt": "Mirror the level horizontally.", "cmd": "gst map-mirror f.json -o m.json --axis h", "checks": [["exit", 0], ["tiled_mirror_h", "f.json", "m.json", "ground"]], "pre": ["gst map-fill map.json -o f.json --layer ground --gid 2 --rect 0,0,3,2"]}
{"id": "map_rotate_90", "tool": "map-rotate", "prompt": "Rotate the 10x8 map by 90 degrees.", "cmd": "gst map-rotate map.json -o r.json --degrees 90", "checks": [["exit", 0], ["tiled_dims", "r.json", 8, 10], ["tiled_layer_count", "r.json", "walls", 2, 32]]}
{"id": "map_crop", "tool": "map-crop", "prompt": "Crop the map to its used area.", "cmd": "gst map-crop map.json -o c.json", "checks": [["exit", 0], ["tiled_dims", "c.json", 10, 8]]}
{"id": "map_stamp", "tool": "map-stamp", "prompt": "Stamp a 2x2 pillar prefab (gid 2) onto the ground layer at 4,3.", "cmd": "gst map-stamp map.json --prefab p2.json --at 4,3 --layer ground --tiles-only -o s.json", "checks": [["exit", 0], ["tiled_layer_count", "s.json", "ground", 2, 4]], "pre": ["gst map-blank -o p.json --size 2x2 --tile 16 --layers ground --tileset tiles.png --tilecount 2 --columns 2", "gst map-fill p.json -o p2.json --layer ground --gid 2 --rect 0,0,2,2"]}
{"id": "map_path_found", "tool": "map-path", "prompt": "Find a path from the spawn object to the goal object, walls solid.", "cmd": "gst map-path map.json --start-name spawn --goal-name goal --solid-layer walls --json p.json --fail-if-none", "checks": [["exit", 0], ["json", "p.json"]]}
{"id": "map_path_blocked", "tool": "map-path", "prompt": "A wall column splits the map; the spawn-to-goal path must fail.", "cmd": "gst map-path split.json --start-name spawn --goal-name goal --solid-layer walls --fail-if-none", "checks": [["exit_nonzero"]], "pre": ["gst map-fill map.json -o split.json --layer walls --gid 2 --rect 5,0,1,8"]}
{"id": "map_reach_all", "tool": "map-reach", "prompt": "From tile 2,2, how many walkable tiles can I reach? (walls solid)", "cmd": "gst map-reach map.json --start 2,2 --solid-layer walls --json r.json", "checks": [["exit", 0], ["stdout_regex", "\\b48 of 48 walkable"], ["json", "r.json"]]}
{"id": "map_reach_islands", "tool": "map-reach", "prompt": "Fail if the split map has unreachable islands.", "cmd": "gst map-reach split.json --start 2,2 --solid-layer walls --fail-on-islands", "checks": [["exit_nonzero"]], "pre": ["gst map-fill map.json -o split.json --layer walls --gid 2 --rect 5,0,1,8"]}
{"id": "tile_colliders", "tool": "tile-colliders", "prompt": "Merge the solid wall tiles into collision rectangles.", "cmd": "gst tile-colliders map.json --layer walls -o col.json", "checks": [["exit", 0], ["json", "col.json"]]}
{"id": "tile_colliders_to_godot", "tool": "tile-colliders-to-godot", "prompt": "Make a StaticBody2D scene from the wall colliders.", "cmd": "gst tile-colliders-to-godot col.json -o col.tscn", "checks": [["exit", 0], ["starts", "col.tscn", "[gd_scene"], ["contains", "col.tscn", "StaticBody2D"]], "pre": ["gst tile-colliders map.json --layer walls -o col.json"]}
{"id": "nav_to_godot", "tool": "nav-to-godot", "prompt": "Make a NavigationRegion2D for the map, walls solid.", "cmd": "gst nav-to-godot map.json -o nav.tscn --solid-layer walls", "checks": [["exit", 0], ["starts", "nav.tscn", "[gd_scene"], ["contains", "nav.tscn", "NavigationRegion2D"], ["contains", "nav.tscn", "NavigationPolygon"]]}
{"id": "map_to_godot", "tool": "map-to-godot", "prompt": "Export the map as a Godot TileMapLayer scene plus TileSet.", "cmd": "gst map-to-godot map.json -o m.tscn --write-tileset m_ts.tres", "checks": [["exit", 0], ["contains", "m.tscn", "TileMapLayer"], ["starts", "m_ts.tres", "[gd_resource type=\"TileSet\""], ["stdout_regex", "\\b112 cell"]]}
{"id": "map_objects_to_godot", "tool": "map-objects-to-godot", "prompt": "Export the spawn and goal objects to a Godot scene.", "cmd": "gst map-objects-to-godot map.json -o o.tscn", "checks": [["exit", 0], ["starts", "o.tscn", "[gd_scene"], ["contains", "o.tscn", "spawn"], ["contains", "o.tscn", "goal"]]}
{"id": "tile_preview", "tool": "tile-preview", "prompt": "Render the map to a PNG.", "cmd": "gst tile-preview map.json -o tp.png", "checks": [["exit", 0], ["png", "tp.png", 160, 128]]}
{"id": "tile_preview_scale", "tool": "tile-preview", "prompt": "Render the map at 2x.", "cmd": "gst tile-preview map.json -o tp.png --scale 2", "checks": [["exit", 0], ["png", "tp.png", 320, 256]]}
{"id": "tmx_gid_usage", "tool": "tmx-gid-usage", "prompt": "Count GID usage in the map.", "cmd": "gst tmx-gid-usage map.json --json g.json", "checks": [["exit", 0], ["json", "g.json"]]}
{"id": "tilemap_stats", "tool": "tilemap-stats", "prompt": "Stats for the map; fail on empty layers.", "cmd": "gst tilemap-stats map.json --csv s.csv --fail-on-empty-layer", "checks": [["exit", 0], ["csv_rows", "s.csv", 1]]}
{"id": "tilemap_stats_empty_layer", "tool": "tilemap-stats", "prompt": "A blank map must fail --fail-on-empty-layer.", "cmd": "gst tilemap-stats b.json --fail-on-empty-layer", "checks": [["exit_nonzero"]], "pre": ["gst map-blank -o b.json --size 4x4 --layers a"]}
{"id": "tmx_objects_csv", "tool": "tmx-objects-csv", "prompt": "Export the map objects to CSV.", "cmd": "gst tmx-objects-csv map.json -o o.csv", "checks": [["exit", 0], ["csv_rows", "o.csv", 2]]}
{"id": "tmx_to_json", "tool": "tmx-to-json", "prompt": "Convert map.tmx to Tiled JSON.", "cmd": "gst tmx-to-json map.tmx -o t.json", "checks": [["exit", 0], ["tiled_dims", "t.json", 4, 3], ["tiled_layer_count", "t.json", "ground", 2, 2]]}
{"id": "map_auto_layer_sample_rules", "tool": "map-auto-layer", "prompt": "Apply the sample's floor rule table to my map.", "cmd": "gst map-auto-layer map.json --rules $GST_ROOT/examples/sample-topdown/data/floor_rules.json --layer walls -o a.json", "checks": [["exit", 0], ["json_len", "a.json", "layers", 4]]}
{"id": "level_budget_sample", "tool": "level-budget", "prompt": "Check the shipped Ember Crypt levels against their object budget.", "cmd": "gst level-budget $GST_ROOT/examples/sample-topdown/project/levels/floor1.json $GST_ROOT/examples/sample-topdown/project/levels/floor2.json $GST_ROOT/examples/sample-topdown/project/levels/boss.json --budget $GST_ROOT/examples/sample-topdown/data/level_budget.json --fail-on-under", "checks": [["exit", 0]]}
{"id": "tmx_props_lint_sample", "tool": "tmx-props-lint", "prompt": "Lint the shipped Ember Crypt level object properties.", "cmd": "gst tmx-props-lint $GST_ROOT/examples/sample-topdown/project/levels/floor1.json $GST_ROOT/examples/sample-topdown/project/levels/boss.json --schema $GST_ROOT/examples/sample-topdown/data/map_props.schema.json", "checks": [["exit", 0]]}
{"id": "godot_res_lint_clean", "tool": "godot-res-lint", "prompt": "Lint my Godot project for missing res:// paths.", "cmd": "gst godot-res-lint proj --strict", "checks": [["exit", 0]]}
{"id": "godot_res_lint_missing", "tool": "godot-res-lint", "prompt": "The broken project references a missing PNG; lint must fail and name it.", "cmd": "gst godot-res-lint proj_broken --strict", "checks": [["exit_nonzero"], ["stdout_contains", "missing.png"]]}
{"id": "asset_unused", "tool": "asset-unused", "prompt": "Which files in proj/ does nothing reference?", "cmd": "gst asset-unused proj --json u.json", "checks": [["exit", 0], ["json_eq", "u.json", "unused", ["art/orphan.png"]]]}
{"id": "asset_unused_strict", "tool": "asset-unused", "prompt": "Fail CI when unused assets exist.", "cmd": "gst asset-unused proj --strict", "checks": [["exit", 1]]}
{"id": "input_map_lint", "tool": "input-map-lint", "prompt": "Lint the input map in project.godot.", "cmd": "gst input-map-lint proj/project.godot --json im.json", "checks": [["json", "im.json"]]}
{"id": "import_presets_snippet", "tool": "godot-import-presets", "prompt": "Print the pixel-art project.godot defaults.", "cmd": "gst godot-import-presets --project-snippet", "checks": [["exit", 0], ["stdout_regex", "^\\[\\w+\\]"]]}
{"id": "data_to_godot", "tool": "data-to-godot", "prompt": "Turn enemies.csv into a Godot Resource plus script.", "cmd": "gst data-to-godot enemies.csv -o e.tres --script e.gd", "checks": [["exit", 0], ["starts", "e.tres", "[gd_resource"], ["contains", "e.tres", "Slime"], ["contains", "e.gd", "extends"]]}
{"id": "texture_budget", "tool": "texture-budget", "prompt": "Estimate VRAM for the project textures.", "cmd": "gst texture-budget proj --json tb.json", "checks": [["exit", 0], ["json", "tb.json"]]}
{"id": "texture_budget_over", "tool": "texture-budget", "prompt": "Fail when textures exceed a tiny budget.", "cmd": "gst texture-budget proj --fail-over-mb 0.000001", "checks": [["exit_nonzero"]]}
{"id": "asset_manifest_verify", "tool": "asset-manifest", "prompt": "Build a manifest of proj/ and verify it.", "cmd": "gst asset-manifest build proj -o man.json && gst asset-manifest verify man.json proj", "checks": [["exit", 0], ["json", "man.json"]]}
{"id": "asset_manifest_detects_change", "tool": "asset-manifest", "prompt": "After editing a file, manifest verify must fail.", "cmd": "gst asset-manifest verify man.json proj", "checks": [["exit_nonzero"]], "pre": ["gst asset-manifest build proj -o man.json", "cp frames/walk_1.png proj/art/hero.png"]}
{"id": "asset_rename_apply", "tool": "asset-rename", "prompt": "Prefix every frame filename with hero_.", "cmd": "gst asset-rename run frames --prefix hero_ --apply", "checks": [["exit", 0], ["exists", "frames/hero_walk_0.png"], ["glob", "frames/walk_*.png", 0]]}
{"id": "asset_rename_dry_run", "tool": "asset-rename", "prompt": "Preview the hero_ prefix rename without touching files.", "cmd": "gst asset-rename run frames --prefix hero_", "checks": [["exit", 0], ["exists", "frames/walk_0.png"], ["glob", "frames/hero_*", 0]]}
{"id": "game_data_lint_sample", "tool": "game-data-lint", "prompt": "Lint the Ember Crypt data tables against their schema.", "cmd": "gst game-data-lint $GST_ROOT/examples/sample-topdown/data/schema.json --root $GST_ROOT/examples/sample-topdown/data --strict", "checks": [["exit", 0]]}
{"id": "drop_sim_expect_pass", "tool": "drop-sim", "prompt": "A table that always drops a coin: assert coin chance is 100%.", "cmd": "gst drop-sim loot.json --trials 2000 --seed 1 --expect t:coin:1:1 --json ds.json", "checks": [["exit", 0], ["json", "ds.json"]], "pre": ["echo '{\"tables\": {\"t\": {\"entries\": [{\"item\": \"coin\", \"weight\": 1}]}}}' > loot.json"]}
{"id": "drop_sim_expect_fail", "tool": "drop-sim", "prompt": "Assert the always-coin table drops coins at most 50%: must fail.", "cmd": "gst drop-sim loot.json --trials 2000 --seed 1 --expect t:coin:0:0.5", "checks": [["exit_nonzero"]], "pre": ["echo '{\"tables\": {\"t\": {\"entries\": [{\"item\": \"coin\", \"weight\": 1}]}}}' > loot.json"]}
{"id": "loc_check", "tool": "loc-check", "prompt": "Validate loc.csv.", "cmd": "gst loc-check loc.csv", "checks": [["exit", 0]]}
{"id": "loc_placeholder_ok", "tool": "loc-placeholder-lint", "prompt": "Check placeholders match across languages.", "cmd": "gst loc-placeholder-lint loc.csv", "checks": [["exit", 0]]}
{"id": "loc_placeholder_missing", "tool": "loc-placeholder-lint", "prompt": "German drops {n} in loc_bad.csv: must fail.", "cmd": "gst loc-placeholder-lint loc_bad.csv", "checks": [["exit_nonzero"]]}
{"id": "loc_key_lint", "tool": "loc-key-lint", "prompt": "Lint key naming with _ as separator.", "cmd": "gst loc-key-lint loc.csv --separator _", "checks": [["exit", 0]]}
{"id": "loc_stats", "tool": "loc-stats", "prompt": "Summarise loc.csv.", "cmd": "gst loc-stats loc.csv --json ls.json", "checks": [["exit", 0], ["json", "ls.json"]]}
{"id": "pseudoloc", "tool": "pseudoloc", "prompt": "Add a pseudo-localised en_XA column.", "cmd": "gst pseudoloc loc.csv -o p.csv --column en --new-column en_XA", "checks": [["exit", 0], ["csv_header_has", "p.csv", ["id", "en", "en_XA"]], ["csv_rows", "p.csv", 3]]}
{"id": "loc_sort", "tool": "loc-sort", "prompt": "Sort loc.csv by key.", "cmd": "gst loc-sort loc.csv -o s.csv", "checks": [["exit", 0], ["csv_col_sorted", "s.csv", 3]]}
{"id": "loc_merge", "tool": "loc-merge", "prompt": "Merge loc.csv and loc_b.csv; keys only in one file are fine.", "cmd": "gst loc-merge loc.csv loc_b.csv -o m.csv --no-fail", "checks": [["exit", 0], ["csv_rows", "m.csv", 4]]}
{"id": "loc_merge_missing_keys_exit", "tool": "loc-merge", "prompt": "Without --no-fail, keys missing from one side make the merge exit 1 (per --help).", "cmd": "gst loc-merge loc.csv loc_b.csv -o m.csv", "checks": [["exit", 1], ["csv_rows", "m.csv", 4]]}
{"id": "loc_to_godot", "tool": "loc-to-godot", "prompt": "Write a Godot translation CSV for en and de.", "cmd": "gst loc-to-godot loc.csv -o g.csv --key id --langs en,de", "checks": [["exit", 0], ["csv_header_has", "g.csv", ["en", "de"]], ["csv_rows", "g.csv", 3]]}
{"id": "loc_fit_ok", "tool": "loc-fit", "prompt": "Do my strings fit 300 px at 11 px DejaVu?", "cmd": "gst loc-fit loc.csv --font font.ttf --size 11 --limit-default 300 --max-lines 1", "checks": [["exit", 0]]}
{"id": "loc_fit_too_narrow", "tool": "loc-fit", "prompt": "With a 5 px limit every string overflows: must fail.", "cmd": "gst loc-fit loc.csv --font font.ttf --size 11 --limit-default 5 --max-lines 1", "checks": [["exit_nonzero"]]}
{"id": "font_subset", "tool": "font-subset", "prompt": "Subset DejaVu Sans to just ABC.", "cmd": "gst font-subset font.ttf -o sub.ttf --chars ABC", "checks": [["exit", 0], ["font_magic", "sub.ttf"], ["smaller", "sub.ttf", "font.ttf"]]}
{"id": "font_check_ok", "tool": "font-check", "prompt": "Does DejaVu cover every character in chars.txt?", "cmd": "gst font-check chars.txt --font font.ttf", "checks": [["exit", 0]]}
{"id": "font_check_missing", "tool": "font-check", "prompt": "The ABC-only subset cannot cover chars.txt: must fail.", "cmd": "gst font-check chars.txt --font sub.ttf", "checks": [["exit_nonzero"]], "pre": ["gst font-subset font.ttf -o sub.ttf --chars ABC"]}
{"id": "bmfont_gen", "tool": "bmfont-gen", "prompt": "Bake a 16 px BMFont with the characters ABC.", "cmd": "gst bmfont-gen --font font.ttf --size 16 --chars ABC -o bm", "checks": [["exit", 0], ["regex", "bm.fnt", "chars count=\\d+"], ["glob_min", "bm*.png", 1]]}
{"id": "font_to_godot", "tool": "font-to-godot", "prompt": "Make a Godot Theme from the BMFont.", "cmd": "gst font-to-godot bm.fnt -o th.tres", "checks": [["exit", 0], ["starts", "th.tres", "[gd_resource"]], "pre": ["gst bmfont-gen --font font.ttf --size 16 --chars ABC -o bm"]}
{"id": "font_preview", "tool": "font-preview", "prompt": "Render a review sheet of the font at 12 px.", "cmd": "gst font-preview font.ttf -o fp.png --sizes 12", "checks": [["exit", 0], ["png", "fp.png"]]}
{"id": "sfx_gen_count", "tool": "sfx-gen", "prompt": "Generate 3 coin sounds with seed 5.", "cmd": "gst sfx-gen coin -o g -n 3 --seed 5", "checks": [["exit", 0], ["glob", "g/*.wav", 3]]}
{"id": "sfx_gen_deterministic", "tool": "sfx-gen", "prompt": "The same seed must give byte-identical sounds.", "cmd": "gst sfx-gen laser -o a -n 1 --seed 5 && gst sfx-gen laser -o b -n 1 --seed 5", "checks": [["exit", 0], ["files_identical", "a/*.wav", "b/*.wav"]]}
{"id": "sfx_pitch_octave", "tool": "sfx-pitch", "prompt": "Pitch tone.wav up an octave (duration halves).", "cmd": "gst sfx-pitch tone.wav -o hi.wav --semitones 12", "checks": [["exit", 0], ["wav", "hi.wav", {"frames_range": [10800, 11250], "rate": 44100}]]}
{"id": "sfx_pitch_ratio", "tool": "sfx-pitch", "prompt": "Play tone.wav at half speed (ratio 0.5, duration doubles).", "cmd": "gst sfx-pitch tone.wav -o lo.wav --ratio 0.5", "checks": [["exit", 0], ["wav", "lo.wav", {"frames_range": [43650, 44550]}]]}
{"id": "sfx_reverse", "tool": "sfx-reverse", "prompt": "Reverse tone.wav.", "cmd": "gst sfx-reverse tone.wav -o r.wav", "checks": [["exit", 0], ["wav_reversed", "tone.wav", "r.wav"]]}
{"id": "sfx_normalize_peak", "tool": "sfx-normalize", "prompt": "Normalise tone.wav to -3 dBFS peak.", "cmd": "gst sfx-normalize tone.wav -o n.wav --peak -3", "checks": [["exit", 0], ["wav_peak_db", "n.wav", -3.0, 0.1]]}
{"id": "wav_gain", "tool": "wav-gain", "prompt": "Turn tone.wav down 6 dB.", "cmd": "gst wav-gain tone.wav --gain -6 -o g.wav", "checks": [["exit", 0], ["wav_peak_db", "g.wav", -12.04, 0.1]]}
{"id": "wav_mono", "tool": "wav-mono", "prompt": "Fold the stereo tone to mono.", "cmd": "gst wav-mono tone_stereo.wav -o m.wav", "checks": [["exit", 0], ["wav", "m.wav", {"channels": 1, "frames": 22050}]]}
{"id": "wav_resample", "tool": "wav-resample", "prompt": "Resample tone.wav to 22050 Hz.", "cmd": "gst wav-resample tone.wav --rate 22050 -o rs.wav", "checks": [["exit", 0], ["wav", "rs.wav", {"rate": 22050, "frames_range": [11015, 11035]}]]}
{"id": "wav_pad_head_tail", "tool": "wav-pad", "prompt": "Add 0.5 s silence before and 0.25 s after tone.wav.", "cmd": "gst wav-pad tone.wav -o p.wav --head 0.5 --tail 0.25", "checks": [["exit", 0], ["wav", "p.wav", {"frames_range": [55120, 55130]}]]}
{"id": "wav_pad_to_duration", "tool": "wav-pad", "prompt": "Pad tone.wav to last 1 second.", "cmd": "gst wav-pad tone.wav -o p.wav --to-duration 1.0", "checks": [["exit", 0], ["wav", "p.wav", {"frames_range": [44095, 44105]}]]}
{"id": "wav_trim_silence", "tool": "wav-trim", "prompt": "Trim the leading/trailing silence off padded.wav.", "cmd": "gst wav-trim padded.wav -o tr", "checks": [["exit", 0], ["wav", "tr/*.wav", {"frames_range": [13000, 20000]}]]}
{"id": "wav_fade", "tool": "wav-fade", "prompt": "Fade tone.wav in and out over 0.1 s.", "cmd": "gst wav-fade tone.wav -o f.wav --in 0.1 --out-dur 0.1", "checks": [["exit", 0], ["wav", "f.wav", {"frames": 22050}], ["wav_first_abs_le", "f.wav", 0.001]]}
{"id": "wav_loop_meta_roundtrip", "tool": "wav-loop-meta", "prompt": "Set loop points 100..1000 on tone.wav and show them.", "cmd": "gst wav-loop-meta set tone.wav --start 100 --end 1000 -o lm.wav && gst wav-loop-meta show lm.wav", "checks": [["exit", 0], ["stdout_regex", "\\b100\\b"], ["stdout_regex", "\\b1000\\b"]]}
{"id": "wav_loop_snap", "tool": "wav-loop-snap", "prompt": "Cut tone.wav to samples 0..9999 with no loop metadata.", "cmd": "gst wav-loop-snap tone.wav -o ls.wav --start 0 --end 9999 --no-meta", "checks": [["exit", 0], ["wav", "ls.wav", {"frames_range": [9999, 10000]}]]}
{"id": "wav_loud_apply", "tool": "wav-loud-apply", "prompt": "Bring quiet.wav to -16 LUFS with a -1 dBTP ceiling.", "cmd": "gst wav-loud-apply quiet.wav -o la --target -16 --max-true-peak -1", "checks": [["exit", 0], ["wav_peak_le", "la/*.wav", -0.9], ["wav_peak_ge", "la/*.wav", -20.0]]}
{"id": "wav_batch_meta", "tool": "wav-batch-meta", "prompt": "Loudness report for two WAVs as CSV.", "cmd": "gst wav-batch-meta tone.wav quiet.wav --csv wb.csv --quiet", "checks": [["csv_rows", "wb.csv", 2]]}
{"id": "cue_sheet", "tool": "cue-sheet", "prompt": "Build a cue sheet for two WAVs.", "cmd": "gst cue-sheet tone.wav quiet.wav --csv cs.csv", "checks": [["exit", 0], ["csv_rows", "cs.csv", 2]]}
{"id": "sfx_envelope", "tool": "sfx-envelope", "prompt": "Apply an ADSR (10/50/0.5/50 ms) to tone.wav.", "cmd": "gst sfx-envelope tone.wav -o env --attack-ms 10 --decay-ms 50 --sustain 0.5 --release-ms 50", "checks": [["exit", 0], ["wav", "env/*.wav", {"frames": 22050}], ["wav_first_abs_le", "env/*.wav", 0.001]]}
{"id": "sfx_variants", "tool": "sfx-variants", "prompt": "Make 3 seeded variations of tone.wav.", "cmd": "gst sfx-variants tone.wav -o var -n 3 --seed 1", "checks": [["exit", 0], ["glob", "var/*.wav", 3]]}
{"id": "sfx_mix", "tool": "sfx-mix", "prompt": "Mix tone.wav and quiet.wav (offset 250 ms), normalised to the -1 dB peak.", "cmd": "gst sfx-mix mix.json -o mix.wav", "checks": [["exit", 0], ["wav", "mix.wav", {"frames_range": [33075, 50000]}], ["wav_peak_db", "mix.wav", -1.0, 0.15]], "pre": ["echo '{\"sample_rate\": 44100, \"channels\": 1, \"normalize\": true, \"peak_db\": -1.0, \"tail_ms\": 100, \"layers\": [{\"file\": \"tone.wav\", \"offset_ms\": 0}, {\"file\": \"quiet.wav\", \"offset_ms\": 250}]}' > mix.json"]}
{"id": "sfx_mix_peak_ceiling", "tool": "sfx-mix", "prompt": "Mix tone.wav with a -10 dB peak ceiling.", "cmd": "gst sfx-mix mix.json -o mix.wav", "checks": [["exit", 0], ["wav_peak_db", "mix.wav", -10.0, 0.15]], "pre": ["echo '{\"sample_rate\": 44100, \"channels\": 1, \"peak_db\": -10.0, \"layers\": [{\"file\": \"tone.wav\"}]}' > mix.json"]}
{"id": "sfx_bank_pack", "tool": "sfx-bank", "prompt": "Pack two WAVs into one audio sprite bank.", "cmd": "gst sfx-bank pack tone.wav quiet.wav -o bank", "checks": [["exit", 0], ["wav", "bank.wav", {"frames_range": [44100, 200000]}], ["json", "bank.json"]]}
{"id": "sfx_spectrogram", "tool": "sfx-spectrogram", "prompt": "Spectrogram of tone.wav.", "cmd": "gst sfx-spectrogram tone.wav -o sp", "checks": [["exit", 0], ["glob_min", "sp/*.png", 1]]}
{"id": "obj_validate", "tool": "obj-validate", "prompt": "Validate cube.obj.", "cmd": "gst obj-validate cube.obj --strict", "checks": [["exit", 0]]}
{"id": "obj_triangulate", "tool": "obj-triangulate", "prompt": "Triangulate cube.obj.", "cmd": "gst obj-triangulate cube.obj -o tri.obj", "checks": [["exit", 0], ["obj_faces", "tri.obj", 12, 3]]}
{"id": "obj_bounds_box", "tool": "obj-bounds", "prompt": "Report cube.obj bounds and write its AABB as an OBJ.", "cmd": "gst obj-bounds cube.obj -o b.json --box box.obj", "checks": [["exit", 0], ["json", "b.json"], ["obj_faces", "box.obj", 12, 3]]}
{"id": "obj_to_glb", "tool": "obj-to-glb", "prompt": "Convert cube.obj to GLB.", "cmd": "gst obj-to-glb cube.obj -o glb", "checks": [["exit", 0], ["glb_magic", "glb/*.glb"]]}
{"id": "gltf_inspect", "tool": "gltf-inspect", "prompt": "Inspect the converted GLB.", "cmd": "gst gltf-inspect glb/*.glb", "checks": [["exit", 0]], "pre": ["gst obj-to-glb cube.obj -o glb"]}
